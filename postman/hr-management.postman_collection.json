{
  "info": {
    "name": "HR Management - API Tests",
    "description": "API tests from current repository. Run entire collection in order, 1 iteration, against LOCAL development only. Creates a unique test user/company/permission and deletes only captured IDs. Regression requests intentionally assert required behavior and may fail on known API bugs. No existing user credentials required.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Auth and test user",
      "item": [
        {
          "name": "01 - Protected request without JWT",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId=Date.now()+\"-\"+Math.random().toString(36).slice(2,8);",
                  "pm.collectionVariables.set(\"runId\",runId);",
                  "pm.collectionVariables.set(\"testEmail\",\"postman-\"+runId+\"@example.test\");",
                  "pm.collectionVariables.set(\"testPassword\",\"Pm!\"+runId+\"Password\");",
                  "[\"accessToken\",\"userId\",\"companyId\",\"permissionId\"].forEach(k=>pm.collectionVariables.unset(k));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Create isolated test user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman {{runId}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"address\": \"Postman test address\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Response envelope\", () => { const j=pm.response.json(); pm.expect(j.statusCode).to.eql(pm.response.code); pm.expect(j).to.have.property(\"data\"); });",
                  "if(pm.response.code===201) { const id=pm.response.json().data.id; pm.test(\"Created ID\",()=>pm.expect(id).to.be.a(\"number\")); pm.collectionVariables.set(\"userId\",id); }pm.test(\"No password in response\",()=>pm.expect(pm.response.json().data).not.to.have.property(\"password\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Reject wrong password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Incorrect-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Login and save JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Response envelope\", () => { const j=pm.response.json(); pm.expect(j.statusCode).to.eql(pm.response.code); pm.expect(j).to.have.property(\"data\"); });",
                  "if(pm.response.code===201) { const d=pm.response.json().data; pm.test(\"Bearer JWT issued\",()=>{pm.expect(d.tokenType).to.eql(\"Bearer\");pm.expect(d.accessToken).to.be.a(\"string\").and.not.empty;}); pm.collectionVariables.set(\"accessToken\",d.accessToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - Authenticated homepage",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Homepage\",()=>pm.expect(pm.response.text()).to.eql(\"Hello Web\"));"
                ]
              }
            }
          ]
        }
      ]
    },
