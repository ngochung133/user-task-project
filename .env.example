# Copy file này thành .env (đã nằm trong .gitignore) và điền giá trị local của bạn
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=hr-managerment
MYSQL_USERNAME=root
MYSQL_PASSWORD=your-mysql-password

# Khóa bí mật HS256 (ít nhất 32 ký tự / 256 bit)
JWT_SECRET=replace-with-a-strong-random-secret-key-at-least-32-chars
